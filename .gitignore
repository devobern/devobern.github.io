# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
.cache/

# Bundler (keep Gemfile.lock tracked)
.bundle/
vendor/
vendor/bundle/

# Environment files
.env
.env.*

# Editors & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml

# Swap / temp / logs
*.swp
*.swo
*.tmp
*.log
*~

# Ruby tooling
.ruby-version
.ruby-gemset
.yardoc
Gemfile.lock
.github/copilot-instructions.md

# Galerie: Original-Fotos (nur generierte WebP werden committed)
# Falls du die Originale auch versionieren möchtest, kommentiere die nächste Zeile aus:
photos/*
!photos/.gitkeep
# Ausnahme: Uploads vom Smartphone werden versioniert, damit sie über die
# GitHub-Weboberfläche hochgeladen werden können. Die Action löscht sie
# nach der Verarbeitung wieder.
!photos/incoming/
