{%- comment -%}
  Sprachspezifischer Atom-Feed. Parameter: include.lang
  Der kombinierte Feed von jekyll-feed bleibt unter /feed.xml bestehen.
{%- endcomment -%}
{%- assign default_lang = site.default_lang | default: 'de' -%}
{%- assign feed_lang = include.lang | default: default_lang -%}
{%- assign li = site.data.i18n[feed_lang] -%}
{%- assign feed_url = '/feed.' | append: feed_lang | append: '.xml' -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ li.html_lang }}">
  <title type="text">{{ site.title }}</title>
  <subtitle>{{ li.site_description }}</subtitle>
  <id>{{ feed_url | absolute_url }}</id>
  <link rel="self" type="application/atom+xml" href="{{ feed_url | absolute_url }}" />
  <link rel="alternate" type="text/html" hreflang="{{ li.hreflang }}" href="{{ li.home | absolute_url }}" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | default: site.title }}</name></author>
  {%- for post in site.posts -%}
    {%- assign post_lang = post.lang | default: default_lang -%}
    {%- if post_lang == feed_lang %}
  <entry>
    <title type="html">{{ post.title | strip_html | normalize_whitespace | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ post.url | absolute_url }}" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
    {%- endif -%}
  {%- endfor %}
</feed>
